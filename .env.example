# Groq API Keys (1 per line, add more for round-robin pool)
# Get keys from: https://console.groq.com/keys
GROQ_API_KEY_1=gsk_your_key_here
GROQ_API_KEY_2=gsk_your_key_here
GROQ_API_KEY_3=gsk_your_key_here
GROQ_API_KEY_4=gsk_your_key_here
GROQ_API_KEY_5=gsk_your_key_here

# Model configuration
GROQ_MODEL=llama-3.3-70b-versatile

# Simulation settings
SIMULATION_SPEED=1.0
MAX_TICKS=1000

# HuggingFace — suppress symlink warning (Windows), use cached models
HF_HUB_DISABLE_SYMLINKS_WARNING=1
TRANSFORMERS_OFFLINE=0

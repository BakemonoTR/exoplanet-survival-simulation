# Optional local-only narrative model. Connect a provider before enabling it.
LOCAL_NARRATIVE_ENABLED=false
LOCAL_NARRATIVE_MODEL=gpt2

# Required for the private /icarus mission-control panel.
ICARUS_ADMIN_PASSWORD=123
# Set to 1 when the deployment is served over HTTPS.
ICARUS_COOKIE_SECURE=0

# Simulation settings
SIMULATION_SPEED=1.0
MAX_TICKS=1000

# HuggingFace — suppress symlink warning (Windows), use cached models
HF_HUB_DISABLE_SYMLINKS_WARNING=1
TRANSFORMERS_OFFLINE=0
